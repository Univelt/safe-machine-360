# PostgreSQL local (Docker) ou Amazon RDS.
# RDS: postgresql://USUARIO:SENHA@SEU-ENDPOINT.rds.amazonaws.com:5432/univelt?sslmode=require
DATABASE_URL="postgresql://univelt:univelt@localhost:5432/univelt?schema=public"

# Segredo da sessão JWT. Gere um valor longo e aleatório em produção.
AUTH_SECRET="troque-este-segredo-em-producao-univelt-nr12"

# Opcional. true em produção atrás de HTTPS.
AUTH_SECURE_COOKIE="false"

# Bucket S3 para fotos e documentos. Deixe S3_BUCKET vazio para usar disco local (uploads/).
# Obs.: não usar prefixo AWS_ nos nomes, é reservado pelo runtime da Amplify/Lambda.
S3_REGION="us-east-1"
S3_BUCKET=""
# Opcional: só necessário fora da AWS (sem IAM role). Em ECS/Amplify prefira a role padrão.
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
